# 可选：开启 GPT 增强总结时填写。零费用模式无需此项。
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5-mini

# GPU 工作节点配置（Python 进程需要单独设置环境变量）。
# large-v3 默认精度优先；base/small/medium 可用于低配置设备。
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
SUMMARY_MODEL=qwen3.5:9b-q8_0
SUMMARY_NUM_CTX=16384
SUMMARY_NUM_BATCH=128
OLLAMA_URL=http://127.0.0.1:11434
# 公网工作节点必须设置；与网页端 GPU_ENGINE_TOKEN 一致。
ENGINE_API_TOKEN=

# Windows 启动器读取系统/终端环境变量，不会自动读取本文件。
# 可将 BILI_APP_URL 设置为自己的网页地址或 http://localhost:5173/。
# BILI_APP_URL=
# BILI_SUMMARY_MODEL=qwen3.5:9b-q8_0
# BILI_SUMMARY_NUM_CTX=16384
# BILI_SUMMARY_NUM_BATCH=128

# 收费系统：站点拥有者的稳定用户 ID。拥有者不限量且最高优先级。
OWNER_USER_ID=

# 公网站点与 GPU 工作节点。生产环境请使用 HTTPS。
PUBLIC_APP_URL=
GPU_ENGINE_URL=
GPU_ENGINE_TOKEN=

# 手机验证：站点向该 HTTPS 地址发送 { phone, code, purpose }。
# 本地联调可打开 SMS_TEST_MODE；生产环境必须关闭。
PHONE_CODE_SECRET=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_TEST_MODE=false

# 支付宝开放平台网页支付（RSA2）。私钥与支付宝公钥都使用 PEM 内容。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
PAYMENT_TEST_MODE=false
