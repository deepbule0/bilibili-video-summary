# 可选：开启 GPT 增强总结时填写。零费用模式无需此项。
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5-mini

# 可选：base 更快，small 默认兼顾准确率，medium 更准但更慢。
WHISPER_MODEL=small

# 收费系统：站点拥有者的稳定用户 ID。拥有者不限量且最高优先级。
OWNER_USER_ID=

# 公网站点与 GPU 工作节点。生产环境请使用 HTTPS。
PUBLIC_APP_URL=
GPU_ENGINE_URL=
GPU_ENGINE_TOKEN=

# 手机验证：站点向该 HTTPS 地址发送 { phone, code, purpose }。
# 本地联调可打开 SMS_TEST_MODE；生产环境必须关闭。
PHONE_CODE_SECRET=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_TEST_MODE=false

# 支付宝开放平台网页支付（RSA2）。私钥与支付宝公钥都使用 PEM 内容。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
PAYMENT_TEST_MODE=false
